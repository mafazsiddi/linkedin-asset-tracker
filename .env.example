# Postgres connection string — Vercel Postgres (Storage tab) or a Neon free-tier project both work.
POSTGRES_URL=postgres://user:password@host/dbname?sslmode=require

# "mock" until the LinkedIn Marketing Developer Platform app is approved, then switch to "live".
LINKEDIN_MODE=live

# The one shared ad account every market's campaigns live under.
LINKEDIN_AD_ACCOUNT_URN=urn:li:sponsoredAccount:509493016

# Only needed once the LinkedIn app is approved (enables LINKEDIN_MODE=live and the /api/auth/linkedin/* endpoints).
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://your-app.vercel.app/api/auth/linkedin/callback

# Protects /api/cron/sync from being called by randoms. Set this in Vercel's env vars —
# Vercel automatically sends it as "Authorization: Bearer <value>" on scheduled cron invocations.
CRON_SECRET=

# How many trailing days each sync re-fetches (default 7). LinkedIn restates a day's numbers for
# ~2-3 days after the fact, and re-fetching a window also backfills any day a run was skipped, so
# month-to-date totals self-correct instead of silently under-counting.
SYNC_WINDOW_DAYS=7

# "Which companies saw this ad set" is fetched on demand and cached per reporting window, because
# LinkedIn only serves that pivot as one aggregate per date range. TTL matches the 2-hourly sync so
# the panel is never staler than the numbers beside it; TOP_N caps how much of the long tail is
# stored (the account reports ~500k engaged companies).
COMPANY_CACHE_TTL_MINUTES=120
COMPANY_TOP_N=100
